{
  "name": "edam",
  "version": "0.0.0",
  "private": true,
  "description": "External Database Audit Monitor - monorepo (Epic E7: Development Environment & Enablement)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "tools/*",
    "infra/*",
    "conformance"
  ],
  "scripts": {
    "build:collector": "esbuild services/cdc-collector/src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/cdc-collector/index.cjs --external:pg-native",
    "build:evidence-writer": "esbuild services/evidence-writer/src/main.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/evidence-writer/index.cjs --external:pg-native",
    "build:normalization": "esbuild services/normalization/src/main.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/normalization/index.cjs --external:pg-native",
    "build:services": "npm run build:collector && npm run build:normalization && npm run build:evidence-writer",
    "compose:up": "docker compose -f deploy/compose/docker-compose.yml up -d",
    "compose:down": "docker compose -f deploy/compose/docker-compose.yml down -v",
    "compose:config": "docker compose -f deploy/compose/docker-compose.yml config",
    "compose:logs": "docker compose -f deploy/compose/docker-compose.yml logs -f",
    "compose-validate": "tsx conformance/scripts/compose-validate.ts",
    "traffic": "tsx tools/traffic-generator/src/index.ts",
    "fixtures:pin": "tsx conformance/scripts/pin-golden-values.ts",
    "fixtures:build": "tsx conformance/scripts/build-fixtures.ts",
    "determinism:rig": "tsx conformance/scripts/determinism-rig.ts",
    "determinism:compare": "tsx conformance/scripts/determinism-compare.ts",
    "conformance": "tsx conformance/scripts/conformance-report.ts",
    "no-write-proof": "tsx conformance/scripts/no-write-proof.ts",
    "evidence-schemas-verbatim": "tsx conformance/scripts/evidence-schemas-verbatim.ts",
    "worm-no-mutate-proof": "tsx conformance/scripts/worm-no-mutate-proof.ts",
    "secret-hygiene": "tsx conformance/scripts/secret-hygiene.ts",
    "signing-key-hygiene": "tsx conformance/scripts/signing-key-hygiene.ts",
    "anchor-no-fabrication": "tsx conformance/scripts/anchor-no-fabrication.ts",
    "verifier-isolation-proof": "tsx conformance/scripts/verifier-isolation-proof.ts",
    "evidence-conformance": "tsx conformance/scripts/evidence-conformance.ts",
    "invariants": "tsx conformance/scripts/invariant-report.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.11.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.0.5"
  }
}
