# EDAM PILOT runtime env — copy to `.env.pilot` and replace ALL CHANGE_ME values.
# Pilot only. No mTLS / dual-control / DR. Run on a PRIVATE/ISOLATED network.

# --- EDAM collector state PostgreSQL ---
PG_USER=edam
PG_PASSWORD=CHANGE_ME
PG_DB=edam_state

# --- Debezium (CDC HTTP/metrics) ---
DEBEZIUM_PORT=8083

# --- WORM evidence store: MinIO with S3 Object Lock ---
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=edam-evidence

# --- WORM separation-of-duties role credentials (provisioned by minio-init) ---
WORM_WRITER_USER=edam-writer
WORM_WRITER_SECRET=CHANGE_ME
WORM_READER_USER=edam-reader
WORM_READER_SECRET=CHANGE_ME
WORM_RETENTION_ADMIN_USER=edam-retention-admin
WORM_RETENTION_ADMIN_SECRET=CHANGE_ME

# --- CDC collector (containerized, R-11) ---
CDC_ENGINE=mysql
CDC_DB_ID=kafel
CDC_SOURCE_STREAMS=kafel
CDC_BUS_STREAM=edam:captured
CDC_CREDENTIAL_REF=edam/cdc/mysql

# --- EXTERNAL Kafel source. The CDC user MUST be READ-ONLY (INV-1); the collector
#     asserts read-only access and never writes the monitored DB. Also used by the
#     operator-supplied Debezium connector config in ./debezium-conf. ---
KAFEL_CDC_USER=cdc_readonly
KAFEL_CDC_PASSWORD=CHANGE_ME
# KAFEL_DB_HOST=kafel-mysql.internal
# KAFEL_DB_PORT=3306
