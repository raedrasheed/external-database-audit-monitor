# EDAM local dev environment overrides (Epic E7 / EDAM-T048).
# Copy to `.env` in this directory to override the DEV defaults baked into
# docker-compose.yml. All values here are throwaway dev credentials.
#
# NOTE: The compose file ships with `${VAR:-default}` fallbacks, so the stack
# runs without a .env file. This file documents the available knobs.

# --- Monitored MySQL ---
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_PORT=3306
KAFEL_DB=kafel

# --- MariaDB (second engine / audit plugin reference) ---
MARIADB_ROOT_PASSWORD=rootpw
MARIADB_PORT=3307

# --- Read-only CDC credential (provisioned by mysql/init/00-users.sql) ---
# These are referenced by debezium/conf/application.properties and stored in
# Vault by vault/seed-vault.sh. The CDC user has NO write grants (INV-1).
CDC_USER=cdc
CDC_PASSWORD=cdc_pw

# --- Native audit reader (read-only) ---
AUDIT_USER=audit_reader
AUDIT_PASSWORD=audit_pw

# --- Redis bus ---
REDIS_PORT=6379

# --- Debezium Server (HTTP/metrics) ---
DEBEZIUM_PORT=8083

# --- EDAM state PostgreSQL ---
PG_USER=edam
PG_PASSWORD=edampw
PG_DB=edam_state
PG_PORT=5432

# --- Vault (dev) ---
VAULT_DEV_ROOT_TOKEN=edam-dev-root
VAULT_PORT=8200
