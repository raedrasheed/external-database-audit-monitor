# EDAM local dev environment overrides (Epic E7 / EDAM-T048).
# Copy to `.env` in this directory to override the DEV defaults baked into
# docker-compose.yml. All values here are throwaway dev credentials.
#
# NOTE: The compose file ships with `${VAR:-default}` fallbacks, so the stack
# runs without a .env file. This file documents the available knobs.

# --- Monitored MySQL ---
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_PORT=3306
KAFEL_DB=kafel

# --- MariaDB (second engine / audit plugin reference) ---
MARIADB_ROOT_PASSWORD=rootpw
MARIADB_PORT=3307

# --- Read-only CDC credential (provisioned by mysql/init/00-users.sql) ---
# These are referenced by debezium/conf/application.properties and stored in
# Vault by vault/seed-vault.sh. The CDC user has NO write grants (INV-1).
CDC_USER=cdc
CDC_PASSWORD=cdc_pw

# --- Native audit reader (read-only) ---
AUDIT_USER=audit_reader
AUDIT_PASSWORD=audit_pw

# --- Redis bus ---
REDIS_PORT=6379

# --- Debezium Server (HTTP/metrics) ---
DEBEZIUM_PORT=8083

# --- EDAM state PostgreSQL ---
PG_USER=edam
PG_PASSWORD=edampw
PG_DB=edam_state
PG_PORT=5432

# --- Vault (dev) ---
VAULT_DEV_ROOT_TOKEN=edam-dev-root
VAULT_PORT=8200

# --- WORM evidence store: MinIO with S3 Object Lock (Sprint-2 / EDAM-T104/T160) ---
# Throwaway dev credentials. minio-init pre-creates the Object-Lock bucket with
# versioning; the evidence writer's ensureBucket() is the final idempotent guard.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=edam-evidence

# --- WORM separation-of-duties role credentials (Sprint-3 / EDAM-S3-SoD) ---
# minio-init provisions three DISTINCT least-privilege MinIO identities (writer /
# reader / retention-admin) with the policies in minio/policies/. Role separation
# is enforced by the STORE (S-6/S-7). Configure MinioWormStore with these via the
# per-role `credentials` config (NOT the dev single-credential fallback).
# Change these dev defaults in any shared/long-lived environment.
WORM_WRITER_USER=edam-writer
WORM_WRITER_SECRET=edam-writer-secret-change-me
WORM_READER_USER=edam-reader
WORM_READER_SECRET=edam-reader-secret-change-me
WORM_RETENTION_ADMIN_USER=edam-retention-admin
WORM_RETENTION_ADMIN_SECRET=edam-retention-admin-secret-change-me

# --- Dev signer / dev TSA+transparency-log (Sprint-2 / EDAM-T160) ---
# DEV TOPOLOGY/HEALTH STAND-INS ONLY — not the real signing/anchoring path. The
# live harness (T161) signs/anchors IN-PROCESS via @edam/signing + @edam/anchoring
# (no drift). Plain HTTP here; production uses mTLS + a real HSM/TSA (spec §15 S-4).
DEV_SIGNER_PORT=8090
DEV_TSA_LOG_PORT=8091
