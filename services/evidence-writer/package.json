{
  "name": "@edam/evidence-writer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domain-B append-only evidence writer (Sprint-2 / EDAM-T106): validate-before-write, deterministic WORM keys, CCE evidence back-refs, DLQ on failure. Append-only — never mutates WORM.",
