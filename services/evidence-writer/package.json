      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@edam/canonical": "*",
    "@edam/contracts": "*",
    "@edam/cce-model": "*",
    "@edam/evidence": "*",
    "@edam/dlq": "*",
    "@edam/worm": "*",
    "@edam/signing": "*",
    "@edam/anchoring": "*",
    "ioredis": "^5.4.1"
  }
}
